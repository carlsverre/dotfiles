#!/usr/bin/env bash
#
# webi-prune -- delete webi package versions that nothing points at any more.
#
# webi installs each package to ~/.local/opt/<pkg>-v<version> and repoints a
# symlink at the new one, but never deletes the old directory. Every upgrade
# leaks a full copy (go ~250M, node ~120M). There is no official cleanup:
# `webi --help` only tells you to rm things by hand.
#
#   webi-prune          # list what would go, then ask
#   webi-prune --yes    # skip the prompt
#
# "Current" means "some live symlink resolves to it" -- not "highest version
# number". The symlinks are what your shell actually runs, so they are the
# only safe source of truth.
set -eEuo pipefail

OPT="${HOME}/.local/opt"

# Everything that pins a version. webi only creates ~/.local/opt/<pkg> for some
# packages (go, node); single-binary ones like rg and fd are pinned solely by
# their ~/.local/bin shim, and go's GOBIN is pinned solely by ~/go.
POINTERS=("$OPT"/* "${HOME}/.local/bin"/* "${HOME}/go")

usage() { sed -n '3,12p' "$0" | sed 's/^# \{0,1\}//'; }

assume_yes=false
case "${1-}" in
    "")        ;;
    -y|--yes)  assume_yes=true ;;
    -h|--help) usage; exit 0 ;;
    *)         usage >&2; exit 1 ;;
esac

[[ -d "$OPT" ]] || { echo "webi-prune: no $OPT, nothing to do"; exit 0; }

# --- work out what is in use ------------------------------------------------

declare -A INUSE=()   # version dir name -> 1   (e.g. node-v24.18.1)
declare -A PINNED=()  # package name     -> 1   (e.g. node)

for link in "${POINTERS[@]}"; do
    [[ -L "$link" ]] || continue
    target="$(readlink -f -- "$link")" || continue
    [[ "$target" == "$OPT/"* ]] || continue

    # ~/.local/opt/fd-v10.4.2/bin/fd -> fd-v10.4.2
    rest="${target#"$OPT"/}"
    version_dir="${rest%%/*}"

    INUSE["$version_dir"]=1
    PINNED["${version_dir%-v*}"]=1
done

# --- work out what is stale -------------------------------------------------

stale=()
unpinned=()

for dir in "$OPT"/*-v*; do
    # Real directories only. Never a symlink -- deleting one of those would
    # take out whatever it points at.
    [[ -d "$dir" && ! -L "$dir" ]] || continue

    name="${dir##*/}"
    [[ -z "${INUSE[$name]-}" ]] || continue

    # If nothing pins ANY version of this package we cannot tell which one is
    # current, and deleting every copy is not a prune. Leave it and say so.
    if [[ -z "${PINNED[${name%-v*}]-}" ]]; then
        unpinned+=("$name")
        continue
    fi

    stale+=("$dir")
done

# --- report -----------------------------------------------------------------

echo "in use:"
for name in $(printf '%s\n' "${!INUSE[@]}" | sort); do
    echo "    $name"
done

if (( ${#unpinned[@]} )); then
    echo
    echo "skipped (nothing points at any version of these, so 'current' is unknown):"
    printf '    %s\n' "${unpinned[@]}"
fi

if (( ${#stale[@]} == 0 )); then
    echo
    echo "nothing to prune"
    exit 0
fi

echo
echo "to delete:"
for dir in "${stale[@]}"; do
    printf '    %-28s %s\n' "${dir##*/}" "$(du -sh "$dir" 2>/dev/null | cut -f1)"
done
echo
echo "    total: $(du -shc "${stale[@]}" 2>/dev/null | tail -1 | cut -f1) in ${#stale[@]} directory(s)"

# --- confirm ----------------------------------------------------------------

if ! $assume_yes; then
    echo
    [[ -t 0 ]] || { echo "webi-prune: not a terminal; re-run with --yes" >&2; exit 1; }
    read -r -p "Delete these? [y/N] " reply
    [[ "$reply" == [yY] ]] || { echo "aborted"; exit 1; }
fi

# --- delete -----------------------------------------------------------------

for dir in "${stale[@]}"; do
    # Re-check every assumption immediately before the rm, in case anything
    # changed while the prompt was open. Bail on the first thing that smells.
    [[ "$dir" == "$OPT"/*-v* ]]    || { echo "refusing: $dir is not $OPT/<pkg>-v<version>" >&2; exit 1; }
    [[ "$dir" != *..* ]]           || { echo "refusing: $dir contains .." >&2; exit 1; }
    [[ -d "$dir" && ! -L "$dir" ]] || { echo "refusing: $dir is not a real directory" >&2; exit 1; }
    [[ -z "${INUSE[${dir##*/}]-}" ]] || { echo "refusing: $dir is in use" >&2; exit 1; }

    chmod -R u+w -- "$dir" 2>/dev/null || true   # go's module cache is read-only
    rm -rf --one-file-system -- "$dir"
    echo "deleted ${dir##*/}"
done
